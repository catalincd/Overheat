# Writes OUT (a header) holding INPUT's bytes as `inline constexpr unsigned char VAR[]`.
file(READ ${INPUT} hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
file(WRITE ${OUT} "// Generated by cmake/embed_file.cmake from ${INPUT} - do not edit.\n#pragma once\n\n"
    "inline constexpr unsigned char ${VAR}[] = {\n${bytes}\n};\n")
