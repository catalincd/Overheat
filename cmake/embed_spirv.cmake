# Writes OUT (a header) with each INPUTS .spv file as a uint32_t array named after it.
set(content "// Generated by cmake/embed_spirv.cmake - do not edit.\n#pragma once\n#include <cstddef>\n#include <cstdint>\n\n")
string(REPLACE "," ";" INPUTS "${INPUTS}")
foreach(spv ${INPUTS})
    get_filename_component(name ${spv} NAME_WE)       # quad.vert.spv -> quad
    get_filename_component(full ${spv} NAME)
    string(REGEX REPLACE "\\.spv$" "" stem ${full})    # quad.vert
    string(REPLACE "." "_" var ${stem})                # quad_vert
    file(READ ${spv} hex HEX)
    string(LENGTH "${hex}" hex_len)
    set(words "")
    set(i 0)
    while(i LESS hex_len)
        # SPIR-V words are little-endian on disk.
        string(SUBSTRING "${hex}" ${i} 8 w)
        string(SUBSTRING "${w}" 6 2 b3)
        string(SUBSTRING "${w}" 4 2 b2)
        string(SUBSTRING "${w}" 2 2 b1)
        string(SUBSTRING "${w}" 0 2 b0)
        string(APPEND words "0x${b3}${b2}${b1}${b0},")
        math(EXPR i "${i} + 8")
        math(EXPR col "${i} % 64")
        if(col EQUAL 0)
            string(APPEND words "\n")
        endif()
    endwhile()
    string(APPEND content "inline constexpr uint32_t spirv_${var}[] = {\n${words}\n};\n\n")
endforeach()
file(WRITE ${OUT} "${content}")
